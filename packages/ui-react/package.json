{
  "name": "@fadenstack/ui-react",
  "version": "0.1.0",
  "description": "The React skin for the Fadenstack chat view models: a Copilot-style chat panel",
  "license": "Apache-2.0",
  "author": "Emagin8 UG (haftungsbeschränkt)",
  "homepage": "https://developers.fadenstack.com/sdk/typescript/",
  "bugs": "https://github.com/fadenstack/fadenstack-sdk-typescript/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/fadenstack/fadenstack-sdk-typescript.git",
    "directory": "packages/ui-react"
  },
  "keywords": [
    "fadenstack",
    "ai",
    "agents",
    "chat",
    "react"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "src",
    "styles.css",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@fadenstack/agents": "0.1.0",
    "@fadenstack/client": "0.1.0",
    "@fadenstack/ui": "0.1.0"
  },
  "peerDependencies": {
    "react": ">=18.2",
    "react-dom": ">=18.2"
  }
}
